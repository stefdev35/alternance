# Configuration de l'API La Bonne Alternance (LBA)
# Copier ce fichier en .env et renseigner les valeurs.
# Clé API à obtenir sur https://api.apprentissage.beta.gouv.fr/fr/compte/profil
LBA_API_BASE_URL=https://api.apprentissage.beta.gouv.fr/api
LBA_API_KEY=

# Base relationnelle DuckDB (fichier local)
DUCKDB_PATH=data/alternance.duckdb

# Base NoSQL MongoDB (docker compose up -d pour la lancer)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=alternance
